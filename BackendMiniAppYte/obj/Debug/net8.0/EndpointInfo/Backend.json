            "type": "integer",
            "format": "int32"
          },
          "mor_Start": {
            "type": "string",
            "format": "time"
          },
          "mor_End": {
            "type": "string",
            "format": "time"
          },
          "aff_Start": {
            "type": "string",
            "format": "time"
          },
          "aff_End": {
            "type": "string",
            "format": "time"
          },
          "duration": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
