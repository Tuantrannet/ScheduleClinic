        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "nullable": true
          },
          "patientName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "gender": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "birthday": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "format": "tel",
            "nullable": true
          },
          "cccd": {
            "type": "string",
            "nullable": true
          },
          "appointments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Appointment"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RequestAppointment": {
        "type": "object",
        "properties": {
          "appoinmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "string",
            "nullable": true
          },
          "appointmentDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Role": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "integer",
            "format": "int32"
          },
          "roleName": {
            "type": "string",
            "nullable": true
          },
          "userRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "userName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "userName": {
            "minLength": 1,
            "type": "string"
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "userRoles": {
            "type": "array",
