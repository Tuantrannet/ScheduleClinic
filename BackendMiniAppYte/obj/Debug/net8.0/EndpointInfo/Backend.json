        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "string",
            "nullable": true
          },
          "appointmentDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "patientInformation": {
            "$ref": "#/components/schemas/PatientInformation"
          },
          "start_Time": {
            "type": "string",
            "format": "time"
          },
          "end_Time": {
            "type": "string",
            "format": "time"
          }
        },
        "additionalProperties": false
